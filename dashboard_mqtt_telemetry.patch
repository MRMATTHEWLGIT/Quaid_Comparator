+    def publish_json(
+        self,
+        topic: str,
+        payload: dict,
+        *,
+        qos: int = 0,
+        retain: bool = False,
+    ) -> None:
+        """Publish UTF-8 JSON to an arbitrary MQTT topic.
+
+        This is used by the comparator dashboard so the policy runtime can
+        publish telemetry without creating a second MQTT connection.
+        """
+
+        encoded_payload = json.dumps(payload).encode('utf-8')
+        self._client.publish(topic, encoded_payload, qos=qos, retain=retain)
