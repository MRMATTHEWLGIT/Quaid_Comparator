+    def _publish_dashboard_payload(self, payload: dict) -> None:
+        """Publish a dashboard payload if dashboard telemetry is enabled."""
+
+        if not self.dashboard_mqtt_enabled:
+            return
+
+        if not self.dashboard_mqtt_topic:
+            return
+
+        controller = getattr(self.env, "controller", None)
+
+        if controller is None:
+            log.debug("Dashboard MQTT telemetry skipped because env has no controller.")
+            return
+
+        try:
+            controller.publish_json(self.dashboard_mqtt_topic, payload, qos=0, retain=False)
+        except AttributeError:
+            log.warning(
+                "Dashboard MQTT telemetry requires MqttController.publish_json(). "
+                "Add the helper method to mqtt_controller.py."
+            )
+        except Exception:
+            log.exception("Failed to publish dashboard MQTT telemetry.")
+
+
+    @staticmethod
+    def _json_loads_or_empty_dict(value) -> dict:
+        """Decode a JSON dictionary, returning an empty dictionary on failure."""
+
+        if value is None:
+            return {}
+
+        try:
+            decoded_value = json.loads(value)
+        except (TypeError, json.JSONDecodeError):
+            return {}
+
+        if isinstance(decoded_value, dict):
+            return decoded_value
+
+        return {}
+
+
+    @staticmethod
+    def _optional_float(value) -> float | None:
+        if value is None:
+            return None
+
+        try:
+            return float(value)
+        except (TypeError, ValueError):
+            return None
+
+
+    @staticmethod
+    def _optional_int(value) -> int | None:
+        if value is None:
+            return None
+
+        try:
+            return int(value)
+        except (TypeError, ValueError):
+            return None
+
